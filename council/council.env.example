# ═══════════════════════════════════════════════
#  JARVIS AI COUNCIL — API KEYS
#  Copy this file, rename to council.env
#  Fill in your keys below
# ═══════════════════════════════════════════════

# ── Anthropic (Claude Opus 4.8 / 4.6 / Sonnet 4.6) ──
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── OpenRouter (GPT-4o, Llama, Qwen) ─────────────
OPENROUTER_API_KEY=sk-or-your-key-here

# ── Your 11 NVIDIA Keys ───────────────────────────
# Each key below maps to one specific model
# Paste your 11 keys here one by one

NVIDIA_KEY_MINIMAX=nvapi-your-minimax-key
NVIDIA_KEY_DEEPSEEK_V4=nvapi-your-deepseek-v4-key
NVIDIA_KEY_DEEPSEEK_PRO=nvapi-your-deepseek-pro-key
NVIDIA_KEY_ZAIGLAM=nvapi-your-zaiglam-key
NVIDIA_KEY_MISTRAL=nvapi-your-mistral-key
NVIDIA_KEY_JAMBA=nvapi-your-jamba-key
NVIDIA_KEY_GEMINI=nvapi-your-gemini-key
NVIDIA_KEY_4=nvapi-your-nvidia-key-4
NVIDIA_KEY_5=nvapi-your-nvidia-key-5
NVIDIA_KEY_6=nvapi-your-nvidia-key-6
NVIDIA_KEY_7=nvapi-your-nvidia-key-7
