# ═══════════════════════════════════════════════════════════════
#  JARVIS AI COUNCIL — API KEYS TEMPLATE
#  INSTRUCTIONS:
#  1. Copy this file → rename to .env (in the council/ folder)
#  2. Replace every PASTE_YOUR_..._HERE with your actual key
#  3. Run: python council.py
#
#  OR just double-click SETUP_JARVIS.bat for a guided setup
# ═══════════════════════════════════════════════════════════════

# ── AWS BEDROCK (PRIMARY SYNTHESIZER — Claude Opus 4.8) ──────────
# Get from: AWS Console → Bedrock → API Keys → Get Started
# This key NEVER expires — most reliable option
AWS_ACCESS_KEY_ID=PASTE_YOUR_AWS_ACCESS_KEY_HERE
AWS_SECRET_ACCESS_KEY=PASTE_YOUR_AWS_SECRET_KEY_HERE
AWS_SESSION_TOKEN=
AWS_REGION=ap-south-1
AWS_BEARER_TOKEN_BEDROCK=PASTE_YOUR_BEDROCK_ABSK_KEY_HERE

# ── ANTHROPIC DIRECT (FALLBACK — only if Bedrock unavailable) ────
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=PASTE_YOUR_SK_ANT_KEY_HERE

# ── OPENROUTER (AI21 Jamba model) ────────────────────────────────
# Get from: openrouter.ai → Keys
OPENROUTER_API_KEY=PASTE_YOUR_SK_OR_KEY_HERE

# ── GOOGLE (Gemini 2.5 Pro) ──────────────────────────────────────
# Get from: aistudio.google.com → Get API Key (starts with AIza)
GOOGLE_API_KEY=PASTE_YOUR_GOOGLE_AIza_KEY_HERE

# ── NVIDIA NIM (10 models — one key works for ALL) ───────────────
# Get from: build.nvidia.com → Get API Key (starts with nvapi-)
# All 10 slots below can use the SAME key
NVIDIA_KEY_LLAMA4_MAV=PASTE_YOUR_NVAPI_KEY_HERE
NVIDIA_KEY_LLAMA4_SCOUT=PASTE_YOUR_NVAPI_KEY_HERE
NVIDIA_KEY_LLAMA33=PASTE_YOUR_NVAPI_KEY_HERE
NVIDIA_KEY_QWEN=PASTE_YOUR_NVAPI_KEY_HERE
NVIDIA_KEY_KIMI=PASTE_YOUR_NVAPI_KEY_HERE
NVIDIA_KEY_MISTRAL=PASTE_YOUR_NVAPI_KEY_HERE
NVIDIA_KEY_ZAIGLAM=PASTE_YOUR_NVAPI_KEY_HERE
NVIDIA_KEY_DEEPSEEK_V4=PASTE_YOUR_NVAPI_KEY_HERE
NVIDIA_KEY_DEEPSEEK_PRO=PASTE_YOUR_NVAPI_KEY_HERE
NVIDIA_KEY_MINIMAX=PASTE_YOUR_NVAPI_KEY_HERE
