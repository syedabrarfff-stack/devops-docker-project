[Unit]
Description=JARVIS PostgreSQL Backup to S3
After=jarvis-stable.service
Requires=jarvis-stable.service

[Service]
Type=oneshot
User=root
ExecStart=/bin/bash /opt/jarvis/scripts/backup-postgres.sh
StandardOutput=journal
StandardError=journal
Environment="AWS_REGION=ap-south-2"
Environment="POSTGRES_DB=jarvis"
Environment="POSTGRES_USER=jarvis"
EnvironmentFile=/opt/jarvis/.env

[Install]
WantedBy=multi-user.target
