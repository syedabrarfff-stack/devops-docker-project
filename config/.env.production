# ════════════════════════════════════════════════════════════════
#  JARVIS — Production Environment Template
#  NEVER commit actual values. Use AWS Secrets Manager in ECS.
#  For local prod testing: cp config/.env.production .env
# ════════════════════════════════════════════════════════════════

# ─── Application ─────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET_KEY_64_CHARS_MINIMUM
CORS_ORIGINS=https://your-domain.com
APP_BASE_URL=https://api.your-domain.com

# ─── Database (RDS in production) ────────────────────────────────
DATABASE_URL=postgresql+asyncpg://jarvis:REPLACE_PASSWORD@REPLACE_RDS_ENDPOINT:5432/jarvis
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ─── Redis (ElastiCache in production) ───────────────────────────
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@REPLACE_ELASTICACHE_ENDPOINT:6379/0
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD

# ─── AI Providers ────────────────────────────────────────────────
# In ECS: injected from AWS Secrets Manager — do NOT hardcode here
ANTHROPIC_API_KEY=SECRETS_MANAGER
OPENAI_API_KEY=SECRETS_MANAGER
GOOGLE_API_KEY=SECRETS_MANAGER
DEEPSEEK_API_KEY=SECRETS_MANAGER
GROQ_API_KEY=SECRETS_MANAGER
MISTRAL_API_KEY=SECRETS_MANAGER
MOONSHOT_API_KEY=SECRETS_MANAGER
ZHIPUAI_API_KEY=SECRETS_MANAGER
DASHSCOPE_API_KEY=SECRETS_MANAGER
MINIMAX_API_KEY=SECRETS_MANAGER
NVIDIA_API_KEY=SECRETS_MANAGER

# ─── Notifications ───────────────────────────────────────────────
SLACK_WEBHOOK_URL=SECRETS_MANAGER
TELEGRAM_BOT_TOKEN=SECRETS_MANAGER
TELEGRAM_CHAT_ID=SECRETS_MANAGER

# ─── Gmail OAuth ─────────────────────────────────────────────────
GMAIL_ADDRESS=REPLACE
GMAIL_CLIENT_ID=SECRETS_MANAGER
GMAIL_CLIENT_SECRET=SECRETS_MANAGER

# ─── Connectors ──────────────────────────────────────────────────
APOLLO_API_KEY=SECRETS_MANAGER
HUBSPOT_API_KEY=SECRETS_MANAGER

# ─── Payments ────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=SECRETS_MANAGER
PAYPAL_CLIENT_SECRET=SECRETS_MANAGER
PAYPAL_MODE=live

# ─── AWS ─────────────────────────────────────────────────────────
USE_AWS=true
AWS_REGION=ap-south-2
AWS_BACKUP_REGION=ap-south-1
AWS_S3_BUCKET=jarvis-production-data-ACCOUNT_ID
AWS_ECS_CLUSTER=jarvis-production-cluster
AWS_ECS_SERVICE=jarvis-production-backend
