# ════════════════════════════════════════════════════════════════
#  JARVIS — Development Environment
#  Usage: cp config/.env.development .env
# ════════════════════════════════════════════════════════════════

# ─── Application ─────────────────────────────────────────────────
DEBUG=true
SECRET_KEY=dev-secret-key-change-for-prod-minimum-32-chars
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
APP_BASE_URL=http://localhost:8000

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis_secret@localhost:5432/jarvis
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis_secret

# ─── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ─── AI Providers — add at least ONE to enable AI features ──────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
ZHIPUAI_API_KEY=
DASHSCOPE_API_KEY=
MINIMAX_API_KEY=
NVIDIA_API_KEY=

# ─── Notifications ───────────────────────────────────────────────
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Gmail (dev: use SMTP app password) ──────────────────────────
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ─── Connectors ──────────────────────────────────────────────────
APOLLO_API_KEY=
HUBSPOT_API_KEY=

# ─── Payments ────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ─── AWS (disabled in dev) ───────────────────────────────────────
USE_AWS=false
AWS_REGION=ap-south-2
