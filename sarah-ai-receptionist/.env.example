# Sarah AI Receptionist — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to git.

# ─── OpenRouter (AI Brain) ───────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here
AI_MODEL=anthropic/claude-sonnet-4-6
AI_MODEL_FAST=anthropic/claude-haiku-4-5-20251001
AI_MODEL_SUMMARY=google/gemini-flash-1.5

# ─── Twilio (Phone) ──────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token-here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ─── Deepgram (Speech-to-Text) ───────────────────────────────────────────────
DEEPGRAM_API_KEY=your-deepgram-key-here

# ─── ElevenLabs (Text-to-Speech) ─────────────────────────────────────────────
ELEVENLABS_API_KEY=your-elevenlabs-key-here
ELEVENLABS_VOICE_ID=your-voice-id-here
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sarah:sarah@localhost:5432/sarah_receptionist
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── AWS (S3 for recordings) ─────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_RECORDINGS=sarah-receptionist-recordings-prod

# ─── JWT Auth ────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=4
LOG_LEVEL=INFO
APP_BASE_URL=https://your-domain.com

# ─── Stripe (Billing) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
