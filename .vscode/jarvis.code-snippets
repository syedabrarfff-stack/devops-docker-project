			"@router.post(\"/$1\")",
			"@limiter.limit(\"$2/minute\")",
			"async def $3(",
			"\trequest: Request,",
			"\tbody: $4,",
			"\tdb: AsyncSession = Depends(get_db),",
			"\t_: dict = Depends(get_current_captain),",
			"\tbg: BackgroundTasks = None,",
			") -> dict:",
			"\t$0"
		],
		"description": "Full FastAPI route with rate limiting + JWT auth (Captain-protected)"
	},
