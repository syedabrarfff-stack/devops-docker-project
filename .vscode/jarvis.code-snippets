	"JARVIS API Hook": {
		"scope": "javascript,javascriptreact",
		"prefix": "jarvis-api-hook",
		"body": [
			"const [$2, set${2/(.*)/${1:/capitalize}/}] = useState($3null)",
			"const [loading, setLoading] = useState(false)",
			"",
			"const fetch${1:Data} = useCallback(async () => {",
			"\tsetLoading(true)",
			"\ttry {",
			"\t\tconst data = await $4()",
			"\t\tset${2/(.*)/${1:/capitalize}/}(data)",
			"\t} catch {}",
			"\tsetLoading(false)",
			"}, [])",
			"",
			"useEffect(() => {",
			"\tfetch${1:Data}()",
			"}, [fetch${1:Data}])"
		],
		"description": "JARVIS API fetch hook pattern with loading state"
	},

