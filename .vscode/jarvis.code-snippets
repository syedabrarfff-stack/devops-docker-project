	"JARVIS Background Email Send": {
		"scope": "python",
		"prefix": "jarvis-bg-email",
		"body": [
			"async def _send_email_bg(data: dict) -> None:",
			"\tawait send_outbound_email(",
			"\t\tto=data[\"email\"],",
			"\t\tsubject=\"$1\",",
			"\t\tbody=data[\"body\"],",
			"\t\tto_name=data.get(\"name\", \"\"),",
			"\t)",
			"",
			"bg.add_task(_send_email_bg, {\"email\": $2, \"name\": $3, \"body\": $4})"
		],
		"description": "Background email send pattern using FastAPI BackgroundTasks"
	},
