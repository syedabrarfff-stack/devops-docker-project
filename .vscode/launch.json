{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: Local Dev (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host", "0.0.0.0",
        "--port", "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "python": "/usr/local/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "FastAPI: Debug (no reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host", "0.0.0.0",
        "--port", "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "python": "/usr/local/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Alembic: Upgrade Head",
      "type": "debugpy",
      "request": "launch",
      "module": "alembic",
      "args": [
        "upgrade", "head"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "python": "/usr/local/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Alembic: Show Current",
      "type": "debugpy",
      "request": "launch",
      "module": "alembic",
      "args": [
        "current"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "python": "/usr/local/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Alembic: New Migration",
      "type": "debugpy",
      "request": "launch",
      "module": "alembic",
      "args": [
        "revision",
        "--autogenerate",
        "-m", "${input:migrationName}"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "python": "/usr/local/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "python": "/usr/local/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Pytest: All Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${workspaceFolder}/backend",
        "-v"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "python": "/usr/local/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Pytest: Current File",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-v"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "python": "/usr/local/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Frontend: Vite Dev",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Chrome: JARVIS Frontend",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src",
      "sourceMapPathOverrides": {
        "webpack:///src/*": "${webRoot}/*"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Backend + Frontend",
      "configurations": ["FastAPI: Local Dev (uvicorn)", "Frontend: Vite Dev"],
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "JARVIS",
        "order": 1
      }
    }
  ],
  "inputs": [
    {
      "id": "migrationName",
      "type": "promptString",
      "prompt": "Migration description (snake_case)"
    }
  ]
}
