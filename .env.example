# ── OPENAI (GPT-4o, DALL-E 3, Whisper) ───────────────────
OPENAI_API_KEY=sk-...

# ── GOOGLE (Gemini 1.5 Pro / Flash) ──────────────────────
GOOGLE_API_KEY=AIza...

# ── DEEPSEEK (V3 / V4-Pro / V4-Flash) ────────────────────
DEEPSEEK_API_KEY=sk-...

# ── GROQ (Llama 3.3, Llama 4-Scout, Llama 4) ─────────────
