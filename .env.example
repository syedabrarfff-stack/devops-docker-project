# ── NVIDIA (NVIDIA NIM) ───────────────────────────────────
NVIDIA_API_KEY=nvapi-...

# ── ELEVENLABS (Voice Synthesis) ─────────────────────────
ELEVENLABS_API_KEY=sk_...
