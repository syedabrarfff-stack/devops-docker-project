# ════════════════════════════════════════════════════════════════
#  JARVIS — Aliyar Solutions  |  AI Operating System
#  Copy to .env and fill in your keys:  cp .env.example .env
# ════════════════════════════════════════════════════════════════

# ─── Application ─────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=change-this-to-a-long-random-secret-key

# ─── Captain Authentication ───────────────────────────────────────
CAPTAIN_USERNAME=captain
CAPTAIN_PASSWORD=change-this-to-a-strong-password
CORS_ORIGINS=http://localhost:3000,https://aliyarsolutions.com,https://www.aliyarsolutions.com
JARVIS_DEFAULT_TENANT_ID=           # Optional: enables scheduled daily ICP scoring for one tenant

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis_secret@localhost:5432/jarvis
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis_secret

# ─── Anthropic (Claude Sonnet 4.6 / Opus 4.7) ───────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_BUDGET_TOTAL_USD=5.00
CLAUDE_BUDGET_WINDOW_DAYS=14
CLAUDE_RESERVE_RATIO=0.20
CLAUDE_SINGLE_CALL_MAX_USD=0.20

# ─── OpenAI (GPT-4o, GPT-4o-mini, DALL-E 3, Whisper) ────────────
OPENAI_API_KEY=sk-...

# ─── Google (Gemini 1.5 Pro / Flash / Gemini 2.0 Flash) ─────────
GOOGLE_API_KEY=AIza...

# ─── DeepSeek (deepseek-chat / deepseek-reasoner) ────────────────
DEEPSEEK_API_KEY=sk-...

# ─── Groq (Llama 3.3, Llama 4-Scout, Llama 4) ───────────────────
GROQ_API_KEY=gsk_...

# ─── Mistral AI (Mistral Large) ──────────────────────────────────
MISTRAL_API_KEY=...

# ─── Moonshot AI / Kimi (moonshot-v1-128k) ───────────────────────
MOONSHOT_API_KEY=sk-...

# ─── ZhipuAI (GLM-4 / GLM-4-plus) ───────────────────────────────
ZHIPUAI_API_KEY=...

# ─── Alibaba DashScope (Qwen) ────────────────────────────────────
DASHSCOPE_API_KEY=sk-...

# ─── MiniMax ─────────────────────────────────────────────────────
MINIMAX_API_KEY=...
MINIMAX_GROUP_ID=...

# ─── NVIDIA NIM ──────────────────────────────────────────────────
NVIDIA_API_KEY=nvapi-...

# ─── ElevenLabs (Premium TTS — optional, browser TTS used by default)
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9    # Daniel — British male

# ─── Google Maps (Lead Discovery — finds local businesses with digital gaps)
GOOGLE_MAPS_API_KEY=AIza...                 # Enable "Places API (New)" in Google Cloud Console

# ─── Notifications ───────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# ─── Gmail (Phase 2: SMTP | Phase 3: OAuth) ──────────────────────
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=                 # Phase 2 SMTP — generate in Google Account settings
GMAIL_CLIENT_ID=                    # Phase 3 OAuth — from Google Cloud Console
GMAIL_CLIENT_SECRET=                # Phase 3 OAuth — from Google Cloud Console
# After adding OAuth creds, visit: GET /api/v1/auth/gmail/initiate

# ─── Connectors ──────────────────────────────────────────────────
APOLLO_API_KEY=                     # Required for contact sync (/api/v1/sync/apollo)
HUBSPOT_API_KEY=
NOTION_API_KEY=
STRIPE_SECRET_KEY=sk_live_...
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── AWS (Phase 3/6 — SSM + S3 + ECS production) ───────────────
USE_AWS=false                       # Set true to enable AWS SSM + S3 event lake
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-2               # Hyderabad (primary)
AWS_BACKUP_REGION=ap-south-1        # Mumbai (backup — Phase 2)
AWS_S3_BUCKET=                      # jarvis-production-data-<account_id>
AWS_SSM_PREFIX=/jarvis
AWS_ECS_CLUSTER=                    # jarvis-production-cluster
AWS_ECS_SERVICE=                    # jarvis-production-backend

# ─── Redis (Phase 6 — production cache + Celery) ────────────────
REDIS_URL=redis://localhost:6379/0  # ElastiCache endpoint in production
REDIS_PASSWORD=                     # set for production Redis

# ─── PayPal (Phase 6 — initial payment system) ──────────────────
PAYPAL_CLIENT_ID=                   # from PayPal developer dashboard
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox                 # sandbox | live

# ─── App Base URL (Phase 3 — OAuth redirects) ────────────────────
APP_BASE_URL=http://localhost:8000  # Set to https://api.yourdomain.com in production
