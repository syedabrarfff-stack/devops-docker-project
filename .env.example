# ════════════════════════════════════════════════════════════════
#  JARVIS — Aliyar Solutions  |  AI Operating System
#  Copy to .env and fill in your keys:  cp .env.example .env
#  Variables marked [REQUIRED] will fail docker-compose startup
#  if missing. Variables marked [optional] are safe to leave blank.
# ════════════════════════════════════════════════════════════════

# ─── Application ─────────────────────────────────────────────────
DEBUG=false
# ALLOW_INSECURE_DEV_DEFAULTS=true   # [optional] local dev ONLY — lets DEBUG=true skip the
                                      # SECRET_KEY/CAPTAIN_PASSWORD/DATABASE_URL checks below.
                                      # Never set this in production; leave it unset/false.
SECRET_KEY=change-this-to-a-long-random-secret-key     # [REQUIRED] min 32 chars — openssl rand -hex 32
APP_BASE_URL=https://api.aliyarsolutions.com            # used by OAuth redirects + email links

# ─── Captain Authentication ───────────────────────────────────────
CAPTAIN_USERNAME=captain                                 # [REQUIRED]
CAPTAIN_PASSWORD=change-this-to-a-strong-password        # [REQUIRED] min 20 chars
CORS_ORIGINS=https://aliyarsolutions.com,https://www.aliyarsolutions.com,http://localhost:3000

# ─── Multi-tenancy ───────────────────────────────────────────────
# Optional: enables scheduled daily ICP scoring for one tenant. Leave this line
# with nothing after '=' — docker-compose's env_file loader does NOT strip
# inline comments, so "KEY=  # comment" makes the comment text itself the
# literal value (this bit production: see config.py's tenant-ID sanitizer).
JARVIS_DEFAULT_TENANT_ID=

# ─── Gunicorn / Uvicorn Workers ──────────────────────────────────
WEB_CONCURRENCY=3                   # backend uvicorn worker count (production: 4+)
GUNICORN_WORKERS=3                  # gunicorn worker count (matches WEB_CONCURRENCY)

# ─── Database ────────────────────────────────────────────────────
# [REQUIRED] All four must be set — compose will refuse to start without them
POSTGRES_DB=jarvis_db
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DATABASE_URL=postgresql+asyncpg://jarvis:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/jarvis_db

# ─── Redis ───────────────────────────────────────────────────────
# [REQUIRED] compose will refuse to start without REDIS_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/0

# ─── Anthropic (Claude Sonnet 4.6 / Opus 4.8) ───────────────────
ANTHROPIC_API_KEY=sk-ant-...                             # [REQUIRED] primary reasoning engine
CLAUDE_BUDGET_TOTAL_USD=50.00                            # 14-day rolling spend cap
CLAUDE_BUDGET_WINDOW_DAYS=14
CLAUDE_RESERVE_RATIO=0.20                                # 20% reserved for urgent tasks
CLAUDE_SINGLE_CALL_MAX_USD=1.00                          # per-call ceiling

# ─── OpenAI (GPT-4o, GPT-4o-mini, Whisper) ──────────────────────
OPENAI_API_KEY=sk-...

# ─── Google (Gemini 2.0 Flash / Gemini 1.5 Pro) ─────────────────
GOOGLE_API_KEY=AIza...

# ─── DeepSeek (deepseek-chat / deepseek-reasoner) ────────────────
DEEPSEEK_API_KEY=sk-...

# ─── Groq (Llama 3.3, Llama 4-Scout, Llama 4) ───────────────────
GROQ_API_KEY=gsk_...

# ─── Mistral AI (Mistral Large) ──────────────────────────────────
MISTRAL_API_KEY=...

# ─── Moonshot AI / Kimi (moonshot-v1-128k, Kimi-K2) ─────────────
MOONSHOT_API_KEY=sk-...

# ─── ZhipuAI (GLM-4-Plus) ────────────────────────────────────────
ZHIPUAI_API_KEY=...

# ─── Alibaba DashScope (Qwen-Max) ────────────────────────────────
DASHSCOPE_API_KEY=sk-...

# ─── MiniMax ─────────────────────────────────────────────────────
MINIMAX_API_KEY=...

# ─── NVIDIA NIM (key rotation pool — all keys work for all models)
NVIDIA_API_KEY=nvapi-...
NVIDIA_API_KEY_B=nvapi-...
NVIDIA_API_KEY_C=nvapi-...
NVIDIA_API_KEY_D=nvapi-...
NVIDIA_API_KEY_E=nvapi-...
NVIDIA_API_KEY_F=nvapi-...
NVIDIA_API_KEY_G=nvapi-...
NVIDIA_API_KEY_H=nvapi-...
NVIDIA_API_KEY_I=nvapi-...
NVIDIA_API_KEY_J=nvapi-...

# ─── AWS Bedrock (bearer token fallback) ─────────────────────────
BEDROCK_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=

# ─── ElevenLabs (Premium TTS) ────────────────────────────────────
ELEVENLABS_API_KEY=sk_...                                # optional: browser TTS used if not set
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9               # Daniel — British male

# ─── Notifications ───────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...
TELEGRAM_WEBHOOK_SECRET=...                              # optional: validates X-Telegram-Bot-API-Secret-Token header
VOICE_WEBHOOK_SECRET=...                                 # required in production: validates X-Voice-Webhook-Secret on /api/v1/webhooks/voice/*

# ─── Outbound Email — AWS SES ────────────────────────────────────
OUTBOUND_EMAIL_PROVIDER=ses                              # ses | smtp
EXECUTIVE_EMAIL_NAME=Joseph David
EXECUTIVE_EMAIL_TITLE=Executive Director
EXECUTIVE_EMAIL_ADDRESS=joseph.david@aliyarsolutions.com
SES_FROM_NAME=Joseph David
SES_FROM_EMAIL=joseph.david@aliyarsolutions.com
SES_CONFIGURATION_SET=jarvis-outreach                   # SES configuration set name
SES_REGION=ap-south-2                                   # SES region — ensure service available
SES_REPLY_TO_EMAIL=replies@inbound.aliyarsolutions.com  # MX must point to SES inbound
EMAIL_REPLY_TO_NAME=Joseph David
OUTREACH_PERSONALIZE_ON_SEND=true
OUTREACH_PAUSED=false

# ─── SMTP (legacy fallback) ──────────────────────────────────────
SMTP_HOST=email-smtp.ap-south-2.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=                                              # SMTP username (SES SMTP user)
EMAIL_PASS=                                              # SMTP password (SES SMTP password)

# ─── Legacy Gmail (retired — OAuth or SES used instead) ──────────
# GMAIL_ADDRESS=
# GMAIL_APP_PASSWORD=
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=

# ─── WhatsApp / Evolution API ────────────────────────────────────
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=evolution
WHATSAPP_INSTANCE_NAME=jarvis-main
WHATSAPP_DISPLAY_IDENTITY=Joseph David
WHATSAPP_CAPTAIN_PHONE=+97334360246                     # Captain's Bahrain number for notifications
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=REPLACE_WITH_STRONG_EVOLUTION_KEY     # [REQUIRED] min 32 chars
EVOLUTION_PUBLIC_URL=https://wa.aliyarsolutions.com
EVOLUTION_WEBHOOK_URL=https://api.aliyarsolutions.com/api/v1/whatsapp/webhook
EVOLUTION_POSTGRES_DB=evolution                          # separate DB Evolution API connects to (see infrastructure/postgres/init.sql)
WHATSAPP_AUTO_REPLY_ENABLED=false
WHATSAPP_AUTO_REPLY_MIN_CONFIDENCE=0.85

# ─── Google Maps (Lead Discovery) ────────────────────────────────
GOOGLE_MAPS_API_KEY=AIza...                              # Enable "Places API (New)" in GCP Console

# ─── Connectors ──────────────────────────────────────────────────
APOLLO_API_KEY=                                          # Required for contact sync (/api/v1/sync/apollo)
HUBSPOT_API_KEY=
NOTION_API_KEY=secret_...
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Stripe ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Wise (International Transfers) ──────────────────────────────
WISE_API_KEY=

# ─── PayPal (legacy payment path) ────────────────────────────────
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox                                      # sandbox | live

# ─── Bank Transfer ───────────────────────────────────────────────
BANK_TRANSFER_ENABLED=true

# ─── n8n Automation Platform ────────────────────────────────────
N8N_BASE_URL=https://automation.aliyarsolutions.com
N8N_WEBHOOK_URL=https://automation.aliyarsolutions.com/webhook
N8N_API_KEY=

# ─── Grafana ─────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_PASSWORD  # [REQUIRED]

# ─── AWS (Phase 3/6 — SSM + S3 + ECS production) ───────────────
USE_AWS=false                                            # true enables AWS SSM + S3 event lake
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=                                       # optional: used for temporary credentials
AWS_REGION=ap-south-2                                   # Hyderabad primary
AWS_BACKUP_REGION=ap-south-1                            # Mumbai DR
AWS_S3_BUCKET=jarvis-production-data
S3_BACKUP_BUCKET=jarvis-backup-data
AWS_SSM_PREFIX=/jarvis
AWS_ECS_CLUSTER=jarvis-production-cluster
AWS_ECS_SERVICE=jarvis-production-backend

# ─── GitHub Bridge (scout network pushes leads to jarvis-data/) ──
GITHUB_TOKEN=ghp_...                                     # PAT with repo:read on scout repos
GITHUB_REPO_OWNER=syedabrarfff-stack
GITHUB_REPO_NAME=devops-docker-project
GITHUB_BRIDGE_BRANCH=claude/jarvis-cans-api-integration-ZThTD

# ─── Autonomous Governance Thresholds ────────────────────────────
AUTONOMOUS_CONFIDENCE_THRESHOLD=0.70
SYSTEM_CONFIDENCE_BASE=0.68
AUTO_APPROVE_PROPOSAL_THRESHOLD_USD=5000.0
AUTO_APPROVE_INVOICE_THRESHOLD_USD=5000.0
AUTO_SEND_OUTREACH=true
AUTO_SEND_OUTREACH_WARM_LEADS_ONLY=true
AUTO_SEND_OUTREACH_MIN_QUALITY_SCORE=0.70

# ─── Outreach ────────────────────────────────────────────────────
OUTREACH_DAILY_SEND_CAP=48
OUTREACH_DOMAIN_AGE_DAYS=365
PILOT_READY=true
EXTERNAL_API_BLOCKERS_BYPASSED_FOR_PILOT=true
