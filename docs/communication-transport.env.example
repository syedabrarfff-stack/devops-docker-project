# AIONX constitutional communication transports
# Email = AWS SES. WhatsApp = existing Bahrain WhatsApp Business via Evolution API.

OUTBOUND_EMAIL_PROVIDER=ses
EXECUTIVE_EMAIL_NAME=Joseph David
EXECUTIVE_EMAIL_TITLE=Executive Director
EXECUTIVE_EMAIL_ADDRESS=joseph.david@aliyarsolutions.com
SES_FROM_NAME=Joseph David
SES_FROM_EMAIL=joseph.david@aliyarsolutions.com
SES_REGION=ap-south-2

WHATSAPP_PROVIDER=evolution
WHATSAPP_ENABLED=true
WHATSAPP_INSTANCE_NAME=jarvis-main
WHATSAPP_DISPLAY_IDENTITY=Joseph David
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_PUBLIC_URL=https://aliyarsolutions.com/evolution
EVOLUTION_WEBHOOK_URL=http://backend:8000/api/v1/webhooks/whatsapp
EVOLUTION_API_KEY=change-this-evolution-key
EVOLUTION_POSTGRES_DB=evolution
EVOLUTION_LOG_LEVEL=ERROR

# Governance: inbound replies generate drafts and update AIONX memory by default.
# Set true only when Captain approves automatic WhatsApp responses.
WHATSAPP_AUTO_REPLY_ENABLED=false
WHATSAPP_AUTO_REPLY_MIN_CONFIDENCE=0.85
