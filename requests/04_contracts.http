@contractId = PASTE_CONTRACT_ID_HERE

###
# GET Contracts — list all (requires JWT)
GET {{baseUrl}}/governance/contracts
Authorization: Bearer {{token}}

###
# GET Contract by ID (requires JWT)
GET {{baseUrl}}/governance/contracts/{{contractId}}
Authorization: Bearer {{token}}

###
# PUT Update Contract Status (requires JWT)
PUT {{baseUrl}}/governance/contracts/{{contractId}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "signed"
}

###
# POST Send Contract via Email to Client (requires JWT)
POST {{baseUrl}}/governance/contracts/{{contractId}}/send-email
Authorization: Bearer {{token}}
